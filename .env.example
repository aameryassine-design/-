# Copier ce fichier en `.env` et remplir les valeurs.
# Ces variables sont injectées au moment du build (elles finissent dans le bundle public).

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Mot de passe d'accès à l'application (protection simple, côté client).
VITE_APP_PASSWORD=change-moi
